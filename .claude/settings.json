{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node tools/validate-questions.mjs 2>&1 | tail -40 || true",
            "statusMessage": "Validation des données…"
          },
          {
            "type": "command",
            "command": "node tools/smoke-test.mjs 2>&1 | tail -40 || true",
            "statusMessage": "Tests de fumée…"
          },
          {
            "type": "command",
            "command": "node tools/check-escaping.mjs 2>&1 | tail -40 || true",
            "statusMessage": "Scan anti-XSS…"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // empty' | { read -r f; [[ \"$f\" == */images/*.png ]] && pngquant --force --quality=65-85 --output /tmp/pq_hook.png \"$f\" 2>/dev/null && cp /tmp/pq_hook.png \"$f\"; } 2>/dev/null || true",
            "statusMessage": "Compression PNG…"
          }
        ]
      }
    ]
  }
}
